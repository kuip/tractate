---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#242424" />
    <meta
      name="description"
      content="An open workspace for crypto contracts on the Kayros lightchain."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}assets/tractate.svg`} />
    <link rel="icon" type="image/png" href={`${base}assets/tractate.png`} />
    <link rel="apple-touch-icon" href={`${base}assets/tractate.png`} />
    <title>Tractate — Contract workspace</title>
  </head>
  <body>
    <div id="editor-root"></div>
    <script>
      import { render } from 'preact';
      import { createElement } from 'preact';
      import App from '../components/App';
      import { loadEditorFonts } from '../lib/fonts';

      const root = document.getElementById('editor-root')!;
      loadEditorFonts()
        .then(() => {
          render(createElement(App, {}), root);
        })
        .catch(() => {
          // Keep the editor unmounted if its fonts fail, with a recovery action.
          const message = document.createElement('p');
          message.setAttribute('role', 'alert');
          message.textContent =
            'Unable to load editor fonts. Check your connection and reload.';
          const retry = document.createElement('button');
          retry.textContent = 'Reload';
          retry.onclick = () => location.reload();
          root.replaceChildren(message, retry);
        });
    </script>
    <noscript>Enable JavaScript to use the Tractate editor.</noscript>
  </body>
</html>
