{
  "name": "tractate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "node scripts/build-preview.mjs",
    "prebuild": "node scripts/build-library.mjs && node scripts/build-extension.mjs && node scripts/build-preview.mjs",
    "format": "prettier --write .",
    "precheck": "node scripts/build-preview.mjs",
    "build:library": "node scripts/build-library.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "test:distribution": "node scripts/check-distribution.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@fontsource/roboto-condensed": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@peculiar/x509": "2.1.0",
    "astro": "7.3.3",
    "codemirror": "6.0.2",
    "idb": "8.0.3",
    "preact": "10.29.8",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
